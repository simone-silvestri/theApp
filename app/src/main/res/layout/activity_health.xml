<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient1"
    tools:context=".HealthActivity">

    <TextView
        android:id="@+id/healthTitle"
        android:layout_width="match_parent"
        android:layout_height="48sp"
        android:gravity="center"
        android:text="@string/health_title"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:fontFamily="@font/mmedium"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/healthBack"
        android:layout_width="48sp"
        android:layout_height="48sp"
        android:background="@color/trans"
        android:src="@drawable/ic_baseline_arrow_back_24"
        android:onClick="closeHealth"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/healthTitle"
        app:layout_constraintBottom_toBottomOf="@+id/healthTitle" />

    <ImageButton
        android:id="@+id/healthSettings"
        android:layout_width="48sp"
        android:layout_height="48sp"
        android:background="@color/trans"
        android:src="@drawable/ic_outline_info_24"
        android:onClick="openGoalSettings"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/healthTitle"
        app:layout_constraintBottom_toBottomOf="@+id/healthTitle" />

    <com.simone.cfts.WeeklyStripView
        android:id="@+id/weeklyStrip"
        android:layout_width="match_parent"
        android:layout_height="110sp"
        android:layout_marginTop="8sp"
        app:layout_constraintTop_toBottomOf="@+id/healthTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/weeklyAvg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2sp"
        android:fontFamily="@font/mlight"
        android:textColor="#C0C0C0"
        android:textSize="12sp"
        tools:text="avg 1,540 kcal / day"
        app:layout_constraintTop_toBottomOf="@+id/weeklyStrip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/weekHeader"
        android:layout_width="match_parent"
        android:layout_height="36sp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2sp"
        app:layout_constraintTop_toBottomOf="@+id/weeklyAvg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/weekPrev"
            android:layout_width="36sp"
            android:layout_height="36sp"
            android:background="@color/trans"
            android:src="@drawable/ic_baseline_arrow_back_24"
            android:scaleType="centerInside"
            android:onClick="openPrevWeek" />

        <TextView
            android:id="@+id/weekOfLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/mlight"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            tools:text="Week of May 25, 2026" />

        <ImageButton
            android:id="@+id/weekNext"
            android:layout_width="36sp"
            android:layout_height="36sp"
            android:background="@color/trans"
            android:src="@drawable/ic_baseline_arrow_back_24"
            android:scaleX="-1"
            android:scaleType="centerInside"
            android:onClick="openNextWeek" />
    </LinearLayout>

    <TextView
        android:id="@+id/totalKcal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp"
        android:fontFamily="@font/mlight"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        tools:text="1,420 / 2,000 kcal"
        app:layout_constraintTop_toBottomOf="@+id/weekHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.simone.cfts.CaloriesHistogramView
        android:id="@+id/histogram"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12sp"
        app:layout_constraintTop_toBottomOf="@+id/totalKcal"
        app:layout_constraintBottom_toTopOf="@+id/chipRow1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/chipRow1"
        android:layout_width="match_parent"
        android:layout_height="55sp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toTopOf="@+id/chipRow2">

        <TextView
            android:id="@+id/chipBreakfast"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2sp"
            android:layout_marginStart="2sp"
            android:layout_marginBottom="2sp"
            android:background="@color/white"
            android:fontFamily="@font/mmedium"
            android:gravity="center"
            android:text="@string/meal_breakfast"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/chipLunch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2sp"
            android:layout_marginStart="2sp"
            android:layout_marginBottom="2sp"
            android:background="@color/white"
            android:fontFamily="@font/mmedium"
            android:gravity="center"
            android:text="@string/meal_lunch"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chipRow2"
        android:layout_width="match_parent"
        android:layout_height="55sp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/chipDinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2sp"
            android:layout_marginStart="2sp"
            android:layout_marginBottom="2sp"
            android:background="@color/white"
            android:fontFamily="@font/mmedium"
            android:gravity="center"
            android:text="@string/meal_dinner"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/chipExtra"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2sp"
            android:layout_marginStart="2sp"
            android:layout_marginBottom="2sp"
            android:background="@color/white"
            android:fontFamily="@font/mmedium"
            android:gravity="center"
            android:text="@string/meal_extra"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="18sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
