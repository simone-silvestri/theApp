<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient1"
    tools:context=".HealthActivity">

    <!-- ====== HEADER ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="18dp"
        android:paddingBottom="4dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <ImageButton
            android:id="@+id/healthBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/trans"
            android:padding="4dp"
            android:onClick="closeHealth"
            android:src="@drawable/ic_baseline_arrow_back_24" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/healthTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mmedium"
            android:text="HEALTH"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:letterSpacing="0.18" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/healthSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/trans"
            android:padding="4dp"
            android:onClick="openGoalSettings"
            android:src="@drawable/ic_outline_info_24" />
    </LinearLayout>

    <View
        android:layout_width="42dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:background="#E58E26" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/mlight"
        android:textStyle="italic"
        android:text="— track the day. shape the week."
        android:textColor="#7A8FB0"
        android:textSize="12sp" />

    <!-- ====== WEEK NAV (above strip) ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <ImageButton
            android:id="@+id/weekPrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/trans"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:onClick="openPrevWeek"
            android:src="@drawable/ic_baseline_arrow_back_24" />

        <TextView
            android:id="@+id/weekOfLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/mmedium"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:letterSpacing="0.30"
            tools:text="WEEK OF 25 MAY" />

        <ImageButton
            android:id="@+id/weekNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/trans"
            android:padding="6dp"
            android:scaleX="-1"
            android:scaleType="centerInside"
            android:onClick="openNextWeek"
            android:src="@drawable/ic_baseline_arrow_back_24" />
    </LinearLayout>

    <!-- ====== WEEKLY STRIP ====== -->
    <com.simone.cfts.WeeklyStripView
        android:id="@+id/weeklyStrip"
        android:layout_width="match_parent"
        android:layout_height="120sp"
        android:layout_marginTop="6sp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp" />

    <!-- Weekly average caption -->
    <TextView
        android:id="@+id/weeklyAvg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/mlight"
        android:textStyle="italic"
        android:textColor="#7A8FB0"
        android:textSize="12sp"
        tools:text="avg 1,540 kcal / day" />

    <!-- separator hairline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="14dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:background="#33FFFFFF" />

    <!-- ====== DAY SECTION ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="18dp">

        <!-- CALORIES · WEIGHT toggle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabCaloriesGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:onClick="selectCaloriesTab"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tabCalories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/mmedium"
                    android:text="CALORIES"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:letterSpacing="0.22" />

                <View
                    android:id="@+id/tabCaloriesTick"
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:background="#E58E26" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabWeightGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:onClick="selectWeightTab"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tabWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/mmedium"
                    android:text="WEIGHT"
                    android:textColor="#7A8FB0"
                    android:textSize="12sp"
                    android:letterSpacing="0.22" />

                <View
                    android:id="@+id/tabWeightTick"
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== CALORIES PANE ===== -->
        <LinearLayout
            android:id="@+id/caloriesPane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Total kcal (italic mlight hero) -->
            <TextView
                android:id="@+id/totalKcal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/mlight"
                android:textStyle="italic"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="30sp"
                tools:text="1,420 / 2,000 kcal" />

            <!-- Slim stacked progress bar -->
            <com.simone.cfts.KcalStackedBarView
                android:id="@+id/stackedBar"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="14dp" />

            <!-- Bar caption -->
            <TextView
                android:id="@+id/barCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/mlight"
                android:textStyle="italic"
                android:gravity="center"
                android:textColor="#7A8FB0"
                android:textSize="11sp"
                tools:text="580 to go" />

            <!-- Meal rows container -->
            <LinearLayout
                android:id="@+id/mealsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="22dp" />
        </LinearLayout>

        <!-- ===== WEIGHT PANE ===== -->
        <LinearLayout
            android:id="@+id/weightPane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.simone.cfts.WeightChartView
                android:id="@+id/weightChart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/weightLatest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/mlight"
                android:textStyle="italic"
                android:gravity="center"
                android:textColor="#7A8FB0"
                android:textSize="12sp"
                tools:text="latest 72.4 kg · week median 72.6 kg" />

            <!-- weigh-in row (built in code to reuse the meal-row look) -->
            <LinearLayout
                android:id="@+id/weighInContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
