<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient1"
    tools:context=".WorkoutActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/title_list"
        android:layout_width="match_parent"
        android:layout_height="48sp"
        android:gravity="center"
        android:text="WORKOUTS"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:fontFamily="@font/mmedium"
        android:letterSpacing="0.18"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48sp"
        android:layout_height="48sp"
        android:background="@color/trans"
        android:src="@drawable/ic_baseline_arrow_back_24"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_list"
        app:layout_constraintBottom_toBottomOf="@+id/title_list" />

    <!-- Orange accent bar -->
    <View
        android:id="@+id/accentBar"
        android:layout_width="48dp"
        android:layout_height="3dp"
        android:background="#E58E26"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/title_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Italic kicker -->
    <TextView
        android:id="@+id/kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/mlight"
        android:text="— browse. filter. choose your pain."
        android:textColor="#7A8FB0"
        android:textSize="12sp"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@+id/accentBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search -->
    <SearchView
        android:id="@+id/workout_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:queryHint="Search workout"
        android:background="@color/trans"
        android:searchHintIcon="@drawable/ic_baseline_search_24"
        android:fontFamily="@font/mlight"
        app:layout_constraintTop_toBottomOf="@+id/kicker"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Intensity label -->
    <TextView
        android:id="@+id/intensityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="22dp"
        android:fontFamily="@font/mmedium"
        android:text="BY INTENSITY"
        android:textColor="#909090"
        android:textSize="11sp"
        android:letterSpacing="0.22"
        app:layout_constraintTop_toBottomOf="@+id/workout_search"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Star filter row + clear -->
    <LinearLayout
        android:id="@+id/intensityRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="22dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="@+id/intensityLabel"
        app:layout_constraintBottom_toBottomOf="@+id/intensityLabel"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/star_white"
            android:background="@color/trans"
            android:onClick="filterWorkout" />

        <ImageView
            android:id="@+id/btn2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/star_white"
            android:background="@color/trans"
            android:onClick="filterWorkout" />

        <ImageView
            android:id="@+id/btn3"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/star_white"
            android:background="@color/trans"
            android:onClick="filterWorkout" />

        <ImageView
            android:id="@+id/btn4"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/star_white"
            android:background="@color/trans"
            android:onClick="filterWorkout" />

        <ImageView
            android:id="@+id/btn5"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/star_white"
            android:background="@color/trans"
            android:onClick="filterWorkout" />

        <ImageView
            android:id="@+id/btnall"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_baseline_clear_24"
            android:background="@color/trans"
            android:onClick="filterWorkout" />
    </LinearLayout>

    <!-- Subtle divider -->
    <View
        android:id="@+id/listDivider"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginTop="14dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:background="#33FFFFFF"
        app:layout_constraintTop_toBottomOf="@+id/intensityLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- The list -->
    <ListView
        android:id="@+id/lv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="@color/trans"
        android:scrollbarSize="3dp"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:scrollingCache="true"
        android:smoothScrollbar="true"
        app:layout_constraintTop_toBottomOf="@+id/listDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
