<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/gradient1"
    tools:context=".AddWorkoutActivity">

    <!-- ====== HEADER ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="18dp"
        android:paddingBottom="4dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/trans"
            android:padding="4dp"
            android:src="@drawable/ic_baseline_arrow_back_24" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mmedium"
            android:text="BUILD"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:letterSpacing="0.18" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/buttoninfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/trans"
            android:padding="4dp"
            android:src="@drawable/ic_outline_info_24" />
    </LinearLayout>

    <View
        android:layout_width="42dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:background="#E58E26" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="22dp"
            android:paddingBottom="120dp">

            <!-- ===========================================
                 MASTHEAD BLOCK
                 (title + type/intensity selectors + sets/pause)
                 =========================================== -->

            <!-- Title (hero, no label) -->
            <EditText
                android:id="@+id/titlename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="name this workout"
                android:textSize="24sp"
                android:fontFamily="@font/mlight"
                android:textStyle="italic"
                android:gravity="center"
                android:textColor="@color/white"
                android:textColorHint="#5A6B85"
                android:background="@color/trans"
                android:inputType="text"
                android:maxLines="1"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="#4DFFFFFF" />

            <!-- editorial deck line below the title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/mlight"
                android:textStyle="italic"
                android:gravity="center"
                android:text="— forge your own hour, your own pain —"
                android:textColor="#7A8FB0"
                android:textSize="12sp"
                android:letterSpacing="0.04" />

            <!-- Type picker (icons only, no section label) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="22dp"
                android:weightSum="3">

                <ImageView
                    android:id="@+id/imgtime"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:onClick="setCurrentType"
                    android:src="@drawable/time" />

                <ImageView
                    android:id="@+id/imgreps"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:onClick="setCurrentType"
                    android:src="@drawable/reps" />

                <ImageView
                    android:id="@+id/imgreptime"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:onClick="setCurrentType"
                    android:src="@drawable/reptime" />
            </LinearLayout>

            <!-- Small italic caption (selected type) -->
            <TextView
                android:id="@+id/typename"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/mlight"
                android:textStyle="italic"
                android:text="H.I.I.T. workout"
                android:textColor="@color/type"
                android:textSize="15sp" />

            <!-- Intensity picker (icons only) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:weightSum="5">

                <ImageView
                    android:id="@+id/imgbeginner"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:onClick="setCurrentDiff"
                    android:src="@drawable/beginner" />

                <ImageView
                    android:id="@+id/imgaverage"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:onClick="setCurrentDiff"
                    android:layout_gravity="center"
                    android:src="@drawable/average" />

                <ImageView
                    android:id="@+id/imgskilled"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:onClick="setCurrentDiff"
                    android:src="@drawable/skilled" />

                <ImageView
                    android:id="@+id/imgexpert"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:onClick="setCurrentDiff"
                    android:src="@drawable/expert" />

                <ImageView
                    android:id="@+id/imgspartan"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:onClick="setCurrentDiff"
                    android:src="@drawable/spartan" />
            </LinearLayout>

            <!-- Small italic caption (selected intensity) -->
            <TextView
                android:id="@+id/diffname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/mlight"
                android:textStyle="italic"
                android:text="Beginner"
                android:textColor="@color/beginner"
                android:textSize="15sp" />

            <!-- Sets / Pause inline strip (one row, no section header) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="26dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mmedium"
                    android:text="SETS"
                    android:textColor="#7A8FB0"
                    android:textSize="12sp"
                    android:letterSpacing="0.28" />

                <EditText
                    android:id="@+id/editsets"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="28dp"
                    android:hint="sets"
                    android:textSize="15sp"
                    android:fontFamily="@font/mlight"
                    android:gravity="start"
                    android:textColor="@color/white"
                    android:textColorHint="#5A6B85"
                    android:background="@color/trans"
                    android:inputType="number"
                    android:maxLines="1"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/pauseOrTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mmedium"
                    android:text="PAUSE"
                    android:textColor="#7A8FB0"
                    android:textSize="12sp"
                    android:letterSpacing="0.28" />

                <EditText
                    android:id="@+id/editpause"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:hint="seconds"
                    android:textSize="15sp"
                    android:fontFamily="@font/mlight"
                    android:gravity="start"
                    android:textColor="@color/white"
                    android:textColorHint="#5A6B85"
                    android:background="@color/trans"
                    android:inputType="number"
                    android:maxLines="1"
                    android:paddingBottom="4dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="#4DFFFFFF" />

            <!-- ===========================================
                 THE FOLD — orange accent bar separating
                 masthead (identity) from body (exercises)
                 =========================================== -->
            <View
                android:layout_width="42dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="34dp"
                android:background="#E58E26" />

            <!-- ===========================================
                 BODY — exercises (the article content)
                 =========================================== -->

            <!-- Section header: EXERCISES with inline ADD button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mmedium"
                    android:text="EXERCISES"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:letterSpacing="0.30" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mmedium"
                    android:text="ADD"
                    android:textColor="#E58E26"
                    android:textSize="11sp"
                    android:letterSpacing="0.30" />

                <ImageButton
                    android:id="@+id/buttonaddexercise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@color/trans"
                    android:padding="2dp"
                    android:onClick="addExerciseToList"
                    android:src="@drawable/ic_menu_add" />
            </LinearLayout>

            <!-- Apply-to-all compact row (mirrors exercise row column structure exactly) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/mlight"
                    android:textStyle="italic"
                    android:text="apply to all"
                    android:textColor="#7A8FB0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txt_general_additional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="2dp"
                    android:fontFamily="@font/mmedium"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/btn_add_general_work"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mlight"
                    android:gravity="end"
                    android:background="@color/trans"
                    android:textSize="14sp"
                    android:textColorHint="#5A6B85"
                    android:hint="sec"
                    android:autofillHints="sec"
                    android:textColor="@color/white"
                    android:inputType="number"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/txt_general_work"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/mmedium"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:text="s" />

                <EditText
                    android:id="@+id/btn_add_general_pause"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mlight"
                    android:gravity="end"
                    android:background="@color/trans"
                    android:textSize="14sp"
                    android:textColorHint="#5A6B85"
                    android:hint="sec"
                    android:autofillHints="sec"
                    android:textColor="@color/white"
                    android:inputType="number"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/txt_general_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/mmedium"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:text="s" />

                <!-- spacer matching delete-button footprint (36dp) + its marginStart=2dp -->
                <View
                    android:layout_width="38dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="#33FFFFFF" />

            <!-- Dynamic list of exercise rows -->
            <LinearLayout
                android:id="@+id/exercise_list_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- ====== BOTTOM CTA ====== -->
    <TextView
        android:id="@+id/btexercise"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:fontFamily="@font/mmedium"
        android:gravity="center"
        android:onClick="createWorkout"
        android:text="SAVE WORKOUT"
        android:textAlignment="center"
        android:textColor="#0D122C"
        android:textSize="20sp"
        android:letterSpacing="0.22" />

</LinearLayout>
