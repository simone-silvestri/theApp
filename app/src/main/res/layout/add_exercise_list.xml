<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    tools:context=".AddWorkoutActivity">

    <!-- exercise name (flex, with dropdown arrow) -->
    <TextView
        android:id="@+id/text_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="select exercise"
        android:textSize="16sp"
        android:textColorHint="#5A6B85"
        android:textColor="@color/white"
        android:fontFamily="@font/mlight"
        android:gravity="start|center_vertical"
        android:ellipsize="end"
        android:maxLines="1"
        android:drawableEnd="@drawable/ic_baseline_arrow_drop_down_24"
        android:drawableRight="@drawable/ic_baseline_arrow_drop_down_24"
        android:drawablePadding="4dp"
        android:background="@color/trans" />

    <!-- additional prefix (e.g., "X" for reptime) -->
    <TextView
        android:id="@+id/txtadditional"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="2dp"
        android:fontFamily="@font/mmedium"
        android:textColor="@color/white"
        android:background="@color/trans"
        android:textSize="14sp" />

    <!-- work value -->
    <EditText
        android:id="@+id/btnaddwork"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/mlight"
        android:gravity="end"
        android:background="@color/trans"
        android:textSize="14sp"
        android:textColorHint="#5A6B85"
        android:hint="sec"
        android:autofillHints="sec"
        android:textColor="@color/white"
        android:inputType="number"
        android:maxLines="1" />

    <!-- work unit -->
    <TextView
        android:id="@+id/txttime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="10dp"
        android:fontFamily="@font/mmedium"
        android:gravity="center"
        android:textColor="@color/white"
        android:background="@color/trans"
        android:textSize="14sp"
        android:text="s" />

    <!-- pause value -->
    <EditText
        android:id="@+id/btnaddpause"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/mlight"
        android:gravity="end"
        android:background="@color/trans"
        android:textSize="14sp"
        android:textColorHint="#5A6B85"
        android:hint="sec"
        android:autofillHints="sec"
        android:textColor="@color/white"
        android:inputType="number"
        android:maxLines="1" />

    <!-- pause unit -->
    <TextView
        android:id="@+id/txtpause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:fontFamily="@font/mmedium"
        android:gravity="center"
        android:textColor="@color/white"
        android:background="@color/trans"
        android:textSize="14sp"
        android:text="s" />

    <!-- delete button (36dp footprint to match apply-to-all spacer) -->
    <ImageButton
        android:id="@+id/btndeleteexercise"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:background="@color/trans"
        android:padding="4dp"
        android:onClick="deleteExerciseFromList"
        android:src="@drawable/ic_baseline_remove_circle_outline_24" />

</LinearLayout>
