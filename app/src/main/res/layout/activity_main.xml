<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient1"
    tools:context=".MainActivity">

    <!-- Date label, top-right — editorial issue marker -->
    <TextView
        android:id="@+id/dateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="22dp"
        android:fontFamily="@font/mmedium"
        android:text="—"
        android:textColor="#909090"
        android:textSize="11sp"
        android:letterSpacing="0.22"
        tools:text="TUE · 31.05.26"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hero block: thin colored bar + huge CORONA + smaller FITNESS -->
    <View
        android:id="@+id/heroAccentBar"
        android:layout_width="48dp"
        android:layout_height="3dp"
        android:background="#E58E26"
        android:layout_marginTop="78dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/heroCorona"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/mmedium"
        android:text="CORONA"
        android:textColor="@color/white"
        android:textSize="48sp"
        android:letterSpacing="0.18"
        app:layout_constraintTop_toBottomOf="@+id/heroAccentBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/heroFitness"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/mlight"
        android:text="FITNESS"
        android:textColor="#C0C0C0"
        android:textSize="20sp"
        android:letterSpacing="0.55"
        app:layout_constraintTop_toBottomOf="@+id/heroCorona"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Italic tagline, lowercase — editorial poetry -->
    <TextView
        android:id="@+id/heroTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="@font/mlight"
        android:gravity="center"
        android:lineSpacingExtra="4sp"
        android:text="no pain.  no gain.\n— a quiet promise to your body —"
        android:textAlignment="center"
        android:textColor="#7A8FB0"
        android:textSize="13sp"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@+id/heroFitness"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Language divider: tiny IT marker, like a magazine column break -->
    <TextView
        android:id="@+id/heroLangMarker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/mmedium"
        android:text="·  IT  ·"
        android:textColor="#909090"
        android:textSize="10sp"
        android:letterSpacing="0.45"
        app:layout_constraintTop_toBottomOf="@+id/heroTagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Italian editorial pull-quote -->
    <TextView
        android:id="@+id/heroItalian"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:fontFamily="@font/mlight"
        android:gravity="center"
        android:lineSpacingExtra="3sp"
        android:text="@string/landing_italian"
        android:textAlignment="center"
        android:textColor="#A3B0CC"
        android:textSize="13sp"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@+id/heroLangMarker"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Icon strip near the bottom -->
    <LinearLayout
        android:id="@+id/icon_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/buttonAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="40dp"
            android:background="@color/trans"
            android:src="@drawable/ic_baseline_person_24"
            android:onClick="openSignIn" />

        <ImageButton
            android:id="@+id/buttonaddworkout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="40dp"
            android:background="@color/trans"
            android:src="@drawable/ic_baseline_library_add_24" />

        <ImageButton
            android:id="@+id/buttonreset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/trans"
            android:src="@drawable/ic_menu_delete" />
    </LinearLayout>

    <!-- Tile row 2 (HEALTH / CALENDAR) -->
    <LinearLayout
        android:id="@+id/tileRow2"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toTopOf="@+id/icon_row">

        <FrameLayout
            android:id="@+id/tile_health"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@color/white"
            android:onClick="openHealth">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="14dp"
                android:fontFamily="@font/mlight"
                android:text="03"
                android:textColor="#B0B0B0"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="22dp"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/mmedium"
                android:text="HEALTH"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="22sp"
                android:letterSpacing="0.12" />

            <View
                android:layout_width="42dp"
                android:layout_height="3dp"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="14dp"
                android:background="#EB2F06" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tile_calendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@color/white"
            android:onClick="openCalendar">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="14dp"
                android:fontFamily="@font/mlight"
                android:text="04"
                android:textColor="#B0B0B0"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="22dp"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/mmedium"
                android:text="CALENDAR"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="22sp"
                android:letterSpacing="0.12" />

            <View
                android:layout_width="42dp"
                android:layout_height="3dp"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="14dp"
                android:background="#6678D1" />
        </FrameLayout>
    </LinearLayout>

    <!-- Tile row 1 (LIST / RANDOM) -->
    <LinearLayout
        android:id="@+id/tileRow1"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tileRow2">

        <FrameLayout
            android:id="@+id/tile_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@color/white"
            android:onClick="openLibrary">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="14dp"
                android:fontFamily="@font/mlight"
                android:text="01"
                android:textColor="#B0B0B0"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="22dp"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/mmedium"
                android:text="LIST"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="22sp"
                android:letterSpacing="0.12" />

            <View
                android:layout_width="42dp"
                android:layout_height="3dp"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="14dp"
                android:background="#F8C291" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tile_random"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@color/white"
            android:onClick="openRandom">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="14dp"
                android:fontFamily="@font/mlight"
                android:text="02"
                android:textColor="#B0B0B0"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="22dp"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/mmedium"
                android:text="RANDOM"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="22sp"
                android:letterSpacing="0.12" />

            <View
                android:layout_width="42dp"
                android:layout_height="3dp"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="14dp"
                android:background="#E58E26" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
