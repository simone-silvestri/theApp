<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient1"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titlepage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30sp"
        android:layout_marginEnd="30sp"
        android:layout_marginTop="20sp"
        android:fontFamily="@font/mlight"
        android:gravity="center"
        android:lineSpacingExtra="8sp"
        android:text="@string/title_string"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/picstatistics"
        android:layout_width="280sp"
        android:layout_height="280sp"
        android:layout_marginTop="10sp"
        android:src="@drawable/home_img_small"
        app:layout_constraintTop_toBottomOf="@+id/titlepage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subtitlepage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30sp"
        android:layout_marginEnd="30sp"
        android:layout_marginTop="10sp"
        android:fontFamily="@font/mlight"
        android:gravity="center"
        android:lineSpacingExtra="4sp"
        android:text="@string/subtitle_string"
        android:textAlignment="center"
        android:textColor="#C0C0C0"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/picstatistics"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- small icon row (account / add / reset) centered above the button rows -->
    <LinearLayout
        android:id="@+id/icon_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="30sp"
        app:layout_constraintBottom_toTopOf="@+id/button_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/buttonAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="36dp"
            android:background="@color/trans"
            android:src="@drawable/ic_baseline_person_24"
            android:onClick="openSignIn" />

        <ImageButton
            android:id="@+id/buttonaddworkout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="36dp"
            android:background="@color/trans"
            android:src="@drawable/ic_baseline_library_add_24" />

        <ImageButton
            android:id="@+id/buttonreset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/trans"
            android:src="@drawable/ic_menu_delete" />
    </LinearLayout>

    <!-- 2×2 skinny button block at bottom -->
    <LinearLayout
        android:id="@+id/button_row_2"
        android:layout_width="match_parent"
        android:layout_height="48sp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tile_health"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:background="@color/white"
            android:fontFamily="@font/mmedium"
            android:gravity="center"
            android:onClick="openHealth"
            android:text="HEALTH"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tile_calendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:background="@color/white"
            android:fontFamily="@font/mmedium"
            android:gravity="center"
            android:onClick="openCalendar"
            android:text="CALENDAR"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/button_row"
        android:layout_width="match_parent"
        android:layout_height="48sp"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/button_row_2">

        <TextView
            android:id="@+id/tile_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:background="@color/white"
            android:fontFamily="@font/mmedium"
            android:gravity="center"
            android:onClick="openLibrary"
            android:text="LIST"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tile_random"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:background="@color/white"
            android:fontFamily="@font/mmedium"
            android:gravity="center"
            android:onClick="openRandom"
            android:text="RANDOM"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="18sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
