<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient1"
    tools:context=".StringActivity">

    <TextView
        android:id="@+id/title_tv"
        android:layout_width="match_parent"
        android:layout_height="48sp"
        android:gravity="center"
        android:text="COPY"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:fontFamily="@font/mmedium"
        android:letterSpacing="0.18"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48sp"
        android:layout_height="48sp"
        android:background="@color/trans"
        android:src="@drawable/ic_baseline_arrow_back_24"
        android:onClick="closeString"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_tv"
        app:layout_constraintBottom_toBottomOf="@+id/title_tv" />

    <ImageButton
        android:id="@+id/buttoninfo"
        android:layout_width="48sp"
        android:layout_height="48sp"
        android:background="@color/trans"
        android:src="@drawable/ic_outline_info_24"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_tv"
        app:layout_constraintBottom_toBottomOf="@+id/title_tv" />

    <View
        android:id="@+id/accentBar"
        android:layout_width="48dp"
        android:layout_height="3dp"
        android:background="#E58E26"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/title_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="@font/mlight"
        android:gravity="center"
        android:text="— paste a workout code. preview before saving."
        android:textAlignment="center"
        android:textColor="#7A8FB0"
        android:textSize="12sp"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@+id/accentBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/codeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginStart="22dp"
        android:fontFamily="@font/mmedium"
        android:text="WORKOUT CODE"
        android:textColor="#909090"
        android:textSize="11sp"
        android:letterSpacing="0.22"
        app:layout_constraintTop_toBottomOf="@+id/kicker"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/workout_string_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:background="@color/trans"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:fontFamily="@font/mlight"
        android:gravity="top|start"
        android:hint="CFLSPASS|…|END"
        android:autofillHints="workout code"
        android:textColorHint="@color/gray"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:minLines="6"
        android:inputType="textMultiLine"
        app:layout_constraintTop_toBottomOf="@+id/codeLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btexercise"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:fontFamily="@font/mmedium"
        android:text="PREVIEW"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="20sp"
        android:letterSpacing="0.22"
        android:background="@color/white"
        android:onClick="openWorkout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
