<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="360dp"
    android:background="#F8F4EC"
    android:orientation="vertical"
    android:paddingTop="30dp"
    android:paddingBottom="14dp"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <!-- Title (dynamic per caller) -->
    <TextView
        android:id="@+id/text_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/mmedium"
        android:gravity="center"
        android:textColor="#0D122C"
        android:textSize="18sp"
        android:textAllCaps="true"
        android:letterSpacing="0.06"
        tools:text="ADD WORKOUT" />

    <!-- Orange accent bar -->
    <View
        android:layout_width="44dp"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:layout_gravity="center"
        android:background="#E58E26" />

    <!-- Row 01 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/mmedium"
            android:gravity="start"
            android:text="01"
            android:textColor="#998A6D"
            android:textSize="24sp"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/button_one"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:fontFamily="@font/mmedium"
            android:textColor="#0D122C"
            android:textSize="17sp"
            android:letterSpacing="0.04"
            android:textAllCaps="true"
            android:clickable="true"
            android:focusable="true"
            android:background="@color/trans"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="BUILD from scratch" />
    </LinearLayout>

    <!-- Hairline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#1A0D122C" />

    <!-- Row 02 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/mmedium"
            android:gravity="start"
            android:text="02"
            android:textColor="#998A6D"
            android:textSize="24sp"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/button_two"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:fontFamily="@font/mmedium"
            android:textColor="#0D122C"
            android:textSize="17sp"
            android:letterSpacing="0.04"
            android:textAllCaps="true"
            android:clickable="true"
            android:focusable="true"
            android:background="@color/trans"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="COPY from string" />
    </LinearLayout>

    <!-- Hairline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#1A0D122C" />

    <!-- Row 03 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/mmedium"
            android:gravity="start"
            android:text="03"
            android:textColor="#998A6D"
            android:textSize="24sp"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/button_three"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:fontFamily="@font/mmedium"
            android:textColor="#0D122C"
            android:textSize="17sp"
            android:letterSpacing="0.04"
            android:textAllCaps="true"
            android:clickable="true"
            android:focusable="true"
            android:background="@color/trans"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="LOAD the og wods" />
    </LinearLayout>

</LinearLayout>
