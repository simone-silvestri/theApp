<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient1"
    tools:context=".Calendar">

    <TextView
        android:id="@+id/calendarTitle"
        android:layout_width="match_parent"
        android:layout_height="48sp"
        android:gravity="center"
        android:text="@string/calendar_title"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:fontFamily="@font/mmedium"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/calendarBack"
        android:layout_width="48sp"
        android:layout_height="48sp"
        android:background="@color/trans"
        android:src="@drawable/ic_baseline_arrow_back_24"
        android:onClick="closeCalendar"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/calendarTitle"
        app:layout_constraintBottom_toBottomOf="@+id/calendarTitle" />

    <ImageButton
        android:id="@+id/calendarSettings"
        android:layout_width="48sp"
        android:layout_height="48sp"
        android:background="@color/trans"
        android:src="@drawable/ic_outline_info_24"
        android:onClick="openGoalSettings"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/calendarTitle"
        app:layout_constraintBottom_toBottomOf="@+id/calendarTitle" />

    <com.simone.cfts.CalendarMonthView
        android:id="@+id/monthGrid"
        android:layout_width="match_parent"
        android:layout_height="270sp"
        android:layout_marginTop="8sp"
        app:layout_constraintTop_toBottomOf="@+id/calendarTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/monthHeader"
        android:layout_width="match_parent"
        android:layout_height="40sp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4sp"
        app:layout_constraintTop_toBottomOf="@+id/monthGrid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/monthPrev"
            android:layout_width="40sp"
            android:layout_height="40sp"
            android:background="@color/trans"
            android:src="@drawable/ic_baseline_arrow_back_24"
            android:scaleType="centerInside"
            android:onClick="openPrevMonth" />

        <TextView
            android:id="@+id/monthLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/mlight"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            tools:text="May 2026" />

        <ImageButton
            android:id="@+id/monthNext"
            android:layout_width="40sp"
            android:layout_height="40sp"
            android:background="@color/trans"
            android:src="@drawable/ic_baseline_arrow_back_24"
            android:scaleX="-1"
            android:scaleType="centerInside"
            android:onClick="openNextMonth" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/detailsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10sp"
        app:layout_constraintTop_toBottomOf="@+id/monthHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/selectedDayHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mmedium"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="20sp"
                tools:text="Saturday, May 30" />

            <LinearLayout
                android:id="@+id/cardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/addWorkoutBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@color/white"
                android:fontFamily="@font/mmedium"
                android:gravity="center"
                android:text="@string/add_workout_to_day"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/monthlyCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/mlight"
                android:gravity="center"
                android:textColor="#C0C0C0"
                android:textSize="14sp"
                tools:text="2 of 22 monthly workouts" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
