<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="320dp"
    android:orientation="vertical"
    android:background="#F8F4EC"
    android:paddingTop="26dp"
    android:paddingBottom="14dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/goalTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/mmedium"
        android:gravity="center"
        android:textColor="#0D122C"
        android:textSize="15sp"
        android:letterSpacing="0.04"
        tools:text="MONTHLY GOAL" />

    <!-- Orange accent bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        android:layout_gravity="center"
        android:background="#E58E26" />

    <!-- Italic kicker -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/mlight"
        android:textStyle="italic"
        android:gravity="center"
        android:text="— how many workouts this month?"
        android:textColor="#7A8FB0"
        android:textSize="12sp" />

    <!-- Number input -->
    <EditText
        android:id="@+id/goalField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/mlight"
        android:textStyle="italic"
        android:gravity="center"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:maxLines="1"
        android:textColor="#0D122C"
        android:textColorHint="#998A6D"
        android:textSize="32sp"
        android:background="@color/trans" />

    <!-- Bottom bar (CANCEL | OK) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <TextView
            android:id="@+id/goalCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:fontFamily="@font/mmedium"
            android:gravity="center"
            android:textColor="#998A6D"
            android:textSize="14sp"
            android:letterSpacing="0.22"
            android:textAllCaps="false"
            android:clickable="true"
            android:focusable="true"
            android:background="@color/trans"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="CANCEL" />

        <View
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:background="#1A0D122C" />

        <TextView
            android:id="@+id/goalOk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:fontFamily="@font/mmedium"
            android:gravity="center"
            android:textColor="#0D122C"
            android:textSize="14sp"
            android:letterSpacing="0.22"
            android:textAllCaps="false"
            android:clickable="true"
            android:focusable="true"
            android:background="@color/trans"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="OK" />
    </LinearLayout>

</LinearLayout>
