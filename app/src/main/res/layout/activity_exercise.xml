<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient1"
    tools:context=".ExerciseActivity">

    <TextView
        android:id="@+id/title_tv"
        android:layout_width="match_parent"
        android:layout_height="48sp"
        android:gravity="center"
        android:text="Exercise"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:fontFamily="@font/mmedium"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/exerciseBack"
        android:layout_width="48sp"
        android:layout_height="48sp"
        android:background="@color/trans"
        android:src="@drawable/ic_baseline_arrow_back_24"
        android:onClick="closeExercise"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_tv"
        app:layout_constraintBottom_toBottomOf="@+id/title_tv" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/title_tv"
        app:layout_constraintBottom_toTopOf="@+id/btnendofpage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <!-- Difficulty -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mmedium"
                android:text="DIFFICULTY"
                android:textColor="#C0C0C0"
                android:textSize="13sp"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:id="@+id/linearlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:weightSum="3">

                <ImageView
                    android:id="@+id/imgeasy"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:onClick="setCurrentDifficulty"
                    android:src="@drawable/easy" />

                <ImageView
                    android:id="@+id/imgintermediate"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:onClick="setCurrentDifficulty"
                    android:src="@drawable/intermediate" />

                <ImageView
                    android:id="@+id/imgadvanced"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:onClick="setCurrentDifficulty"
                    android:src="@drawable/advanced" />
            </LinearLayout>

            <TextView
                android:id="@+id/difftext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/mmedium"
                android:gravity="center"
                android:text="Easy"
                android:textColor="@color/beginner"
                android:textSize="16sp" />

            <!-- Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/mmedium"
                android:text="CATEGORY"
                android:textColor="#C0C0C0"
                android:textSize="13sp"
                android:letterSpacing="0.08" />

            <EditText
                android:id="@+id/editcategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/trans"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:fontFamily="@font/mlight"
                android:textColor="@color/white"
                android:textColorHint="@color/gray"
                android:textSize="15sp"
                android:hint="Pick a category"
                android:autofillHints="category"
                android:focusable="false"
                android:longClickable="false"
                android:clickable="true"
                android:onClick="pickCategory"
                android:gravity="center_vertical"
                android:drawableEnd="@drawable/ic_baseline_arrow_drop_down_24" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/mmedium"
                android:text="DESCRIPTION"
                android:textColor="#C0C0C0"
                android:textSize="13sp"
                android:letterSpacing="0.08" />

            <EditText
                android:id="@+id/editdescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/trans"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:fontFamily="@font/mlight"
                android:gravity="top|start"
                android:hint="Describe how to perform this exercise"
                android:autofillHints="exercise description"
                android:textColorHint="@color/gray"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:minLines="5"
                android:inputType="textMultiLine|textCapSentences" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btnendofpage"
        android:layout_width="match_parent"
        android:layout_height="50sp"
        android:background="@color/white"
        android:fontFamily="@font/mmedium"
        android:gravity="center"
        android:onClick="addExerciseToDatabase"
        android:text="SAVE"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
