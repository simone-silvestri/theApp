<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient1"
    tools:context=".ExerciseActivity">

    <!-- ====== HEADER ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="18dp"
        android:paddingBottom="4dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <ImageButton
            android:id="@+id/exerciseBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/trans"
            android:padding="4dp"
            android:onClick="closeExercise"
            android:src="@drawable/ic_baseline_arrow_back_24" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mmedium"
            android:text="EXERCISE"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:letterSpacing="0.18" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- spacer matching back button width for visual centering -->
        <View
            android:layout_width="32dp"
            android:layout_height="32dp" />
    </LinearLayout>

    <View
        android:layout_width="42dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:background="#E58E26" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="24dp"
            android:paddingBottom="120dp">

            <!-- Exercise name (hero, dynamic) -->
            <TextView
                android:id="@+id/title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mlight"
                android:textStyle="italic"
                android:gravity="center"
                android:text=""
                android:textColor="@color/white"
                android:textSize="28sp" />

            <!-- ====== DIFFICULTY (icons + caption, no section label) ====== -->
            <LinearLayout
                android:id="@+id/linearlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="22dp"
                android:weightSum="3">

                <ImageView
                    android:id="@+id/imgeasy"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:onClick="setCurrentDifficulty"
                    android:src="@drawable/easy" />

                <ImageView
                    android:id="@+id/imgintermediate"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:onClick="setCurrentDifficulty"
                    android:src="@drawable/intermediate" />

                <ImageView
                    android:id="@+id/imgadvanced"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:onClick="setCurrentDifficulty"
                    android:src="@drawable/advanced" />
            </LinearLayout>

            <TextView
                android:id="@+id/difftext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/mlight"
                android:textStyle="italic"
                android:text="Easy"
                android:textColor="@color/beginner"
                android:textSize="15sp" />

            <!-- ====== CATEGORY ====== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/mmedium"
                android:text="CATEGORY"
                android:textColor="#7A8FB0"
                android:textSize="12sp"
                android:letterSpacing="0.30" />

            <EditText
                android:id="@+id/editcategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/trans"
                android:paddingBottom="8dp"
                android:fontFamily="@font/mlight"
                android:textColor="@color/white"
                android:textColorHint="#5A6B85"
                android:textSize="16sp"
                android:hint="pick a category"
                android:autofillHints="category"
                android:focusable="false"
                android:longClickable="false"
                android:clickable="true"
                android:onClick="pickCategory"
                android:gravity="start|center_vertical"
                android:drawableEnd="@drawable/ic_baseline_arrow_drop_down_24"
                android:drawableRight="@drawable/ic_baseline_arrow_drop_down_24"
                android:drawablePadding="4dp"
                android:maxLines="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="#33FFFFFF" />

            <!-- ====== DESCRIPTION ====== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/mmedium"
                android:text="DESCRIPTION"
                android:textColor="#7A8FB0"
                android:textSize="12sp"
                android:letterSpacing="0.30" />

            <EditText
                android:id="@+id/editdescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/trans"
                android:paddingTop="6dp"
                android:paddingBottom="10dp"
                android:fontFamily="@font/mlight"
                android:gravity="top|start"
                android:hint="how to perform this exercise"
                android:autofillHints="exercise description"
                android:textColorHint="#5A6B85"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:minLines="5"
                android:inputType="textMultiLine|textCapSentences" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="#33FFFFFF" />

        </LinearLayout>
    </ScrollView>

    <!-- ====== BOTTOM CTA ====== -->
    <TextView
        android:id="@+id/btnendofpage"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:fontFamily="@font/mmedium"
        android:gravity="center"
        android:onClick="addExerciseToDatabase"
        android:text="SAVE"
        android:textColor="#0D122C"
        android:textSize="20sp"
        android:letterSpacing="0.22" />

</LinearLayout>
