<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient1"
    tools:context=".SignInActivity">

    <!-- Header: back arrow + page title -->
    <TextView
        android:id="@+id/signInTitle"
        android:layout_width="match_parent"
        android:layout_height="48sp"
        android:gravity="center"
        android:text="ACCOUNT"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:fontFamily="@font/mmedium"
        android:letterSpacing="0.18"
        android:layout_marginTop="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/signInBack"
        android:layout_width="48sp"
        android:layout_height="48sp"
        android:background="@color/trans"
        android:src="@drawable/ic_baseline_arrow_back_24"
        android:onClick="closeSignIn"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/signInTitle"
        app:layout_constraintBottom_toBottomOf="@+id/signInTitle" />

    <!-- Orange accent bar — visual signature -->
    <View
        android:id="@+id/signInAccent"
        android:layout_width="48dp"
        android:layout_height="3dp"
        android:background="#E58E26"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@+id/signInTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Signed-out state -->
    <LinearLayout
        android:id="@+id/signedOutPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/signInAccent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Editorial lead-in: stacked italic lines -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mlight"
            android:text="no servers."
            android:textColor="#A3B0CC"
            android:textSize="22sp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mlight"
            android:text="no passwords."
            android:textColor="#A3B0CC"
            android:textSize="22sp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/mmedium"
            android:text="just you."
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="italic"
            android:letterSpacing="0.02" />

        <!-- Small caption -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/mmedium"
            android:text="SIGN IN TO SYNC YOUR DATA"
            android:textColor="#909090"
            android:textSize="11sp"
            android:letterSpacing="0.22" />

        <LinearLayout
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:paddingStart="20dp"
            android:paddingEnd="22dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_google_g"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONTINUE WITH GOOGLE"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="14sp"
                android:fontFamily="@font/mmedium"
                android:letterSpacing="0.16" />

            <View
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:background="#E58E26" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/mlight"
            android:text="— your workouts follow you. across devices, untouched."
            android:textColor="#7A8FB0"
            android:textSize="12sp"
            android:textStyle="italic"
            android:gravity="center"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- Signed-in state -->
    <LinearLayout
        android:id="@+id/signedInPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/signInAccent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mmedium"
            android:text="SIGNED IN AS"
            android:textColor="#909090"
            android:textSize="11sp"
            android:letterSpacing="0.22" />

        <TextView
            android:id="@+id/signedInEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/mmedium"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:letterSpacing="0.04"
            tools:text="simone@gmail.com" />

        <!-- Status row: dot + label, like a magazine status tag -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#03C04A" />

            <TextView
                android:id="@+id/signedInStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/mmedium"
                android:text="SYNCED"
                android:textColor="#03C04A"
                android:textSize="11sp"
                android:letterSpacing="0.22" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/mlight"
            android:text="— your data follows you, untouched."
            android:textColor="#7A8FB0"
            android:textSize="12sp"
            android:textStyle="italic" />

        <View
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:layout_marginTop="42dp"
            android:background="#E58E26" />

        <TextView
            android:id="@+id/btnSignOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/mmedium"
            android:text="SIGN OUT"
            android:textColor="@color/colorPrimaryDark6"
            android:textSize="14sp"
            android:letterSpacing="0.22"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
